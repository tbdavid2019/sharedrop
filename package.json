{
  "name": "sharedrop",
  "version": "1.0.0",
  "private": true,
  "description": "P2P file sharing",
  "license": "MIT",
  "author": "Szymon Nowak",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/szimek/sharedrop.git"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*",
    "develop": "yarn install --frozen-lockfile && nf --procfile=Procfile.dev start",
    "lint:hbs": "ember-template-lint .",
    "lint:js": "eslint .",
    "start": "ember serve",
    "test": "npm-run-all lint:* test:*",
    "test:ember": "ember test"
  },
  "devDependencies": {
    "@ember/jquery": "^2.0.0",
    "@ember/optional-features": "^3.0.0",
    "@glimmer/component": "^2.2.1",
    "@glimmer/tracking": "^1.1.2",
    "babel-eslint": "^10.1.0",
    "broccoli-asset-rev": "^3.0.0",
    "ember-auto-import": "^2.13.1",
    "ember-cli": "~7.3.0",
    "ember-cli-app-version": "^7.0.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-dependency-checker": "^3.3.3",
    "ember-cli-dotenv": "^4.0.0",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sass": "^11.0.1",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-export-application-global": "^2.0.1",
    "ember-fetch": "^8.1.2",
    "ember-load-initializers": "^3.0.1",
    "ember-maybe-import-regenerator": "^1.0.0",
    "ember-qrcode-shim": "^0.5.0",
    "ember-qunit": "^9.2.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.4.0",
    "ember-template-lint": "^7.9.4",
    "eslint": "^10.14.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.9.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "foreman": "3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "loader.js": "^4.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "qunit-dom": "^3.6.0",
    "sass": "^1.107.1"
  },
  "dependencies": {
    "@sentry/browser": "11.10.0",
    "@sentry/integrations": "7.114.0",
    "body-parser": "^2.4.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.1",
    "express": "^5.3.0",
    "firebase-token-generator": "~2.0.0",
    "jszip": "^3.10.2",
    "lodash": "^4.18.1",
    "morgan": "^1.12.1",
    "newrelic": "^14.10.0",
    "stream": "^0.0.3",
    "uuid": "^14.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "yarn run prettier --write",
      "yarn run lint:hbs",
      "yarn run lint:js"
    ]
  },
  "engines": {
    "node": "^14.0.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "paths": [
      "lib/google-analytics"
    ]
  },
  "resolutions": {
    "minimatch": "11.0.1",
    "tmp": "0.2.7",
    "rollup": "2.80.0"
  }
}
